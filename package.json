{
  "name": "riankeng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "riian gèng. A local-first Thai primer. Voice is romanization. Script is the letters.",
  "author": {
    "name": "Luisfer Romero Calero",
    "url": "https://lfrc.me"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "copy": "tsx scripts/dump-learner-copy.ts && slopless content/.learner-copy.md",
    "ground": "python3 scripts/gen-ground.py",
    "audio": "python3 scripts/gen-audio.py",
    "scenes": "python3 scripts/gen-scenes.py",
    "fonts": "python3 scripts/fetch-fonts.py"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.14.5",
    "slopless": "^0.2.38",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
